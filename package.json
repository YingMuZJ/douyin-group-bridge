{
  "name": "douyin-group-bridge",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Douyin group chats to DeepSeek Harness, adapted from Derpyu520/qq-bridge with a native Douyin IM transport.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/douyin/main.mjs",
    "init": "node src/douyin/main.mjs init",
    "login": "node src/douyin/main.mjs login",
    "groups": "node src/douyin/main.mjs groups",
    "members": "node src/douyin/main.mjs members",
    "doctor": "node src/douyin/main.mjs doctor",
    "setup:dsh": "node scripts/setup-douyin-dsh.mjs",
    "test": "node --test tests/douyin/*.test.mjs",
    "test:upstream": "node scripts/test-dsh-inbox-projection.mjs && node scripts/test-mux-reconnect.mjs && node scripts/test-md-to-plain.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-host-apiproxy": "0.1.1-rc.2",
    "douyin-im": "1.1.0",
    "js-yaml": "^4.3.2",
    "ws": "8.21.3"
  }
}
